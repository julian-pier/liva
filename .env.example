# Required: generate each value independently, for example with `openssl rand -hex 32`.
LIVA_FLASK_SECRET=
LIVA_MASTER_SECRET=
LIVA_AUTH_PEPPER=

# Set to 1 only when LIVA is served over HTTPS.
LIVA_SESSION_COOKIE_SECURE=0

# Optional provider integrations. Leave unused values empty.
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=
LIVA_AI_READ_KEY=
LIVA_AI_WRITE_KEY=

# Optional MCP memory vault. Defaults to the platform's user data directory.
LIVA_MEMORY_VAULT=
LIVA_MEMORY_RUNTIME_DIR=
LIVA_MEMORY_URL=
MEMOS_BASE_URL=

# Optional smart-home support. Device maps are JSON objects keyed by a local name.
LIVA_TAPO_USERNAME=
LIVA_TAPO_PASSWORD=
LIVA_TAPO_DEVICES_JSON={}
LIVA_GOVEE_ENABLED=0
LIVA_GOVEE_DEVICES_JSON={}

# Optional shift-plan import. No person is selected by default.
LIVA_SHIFT_TARGET_NAME=
