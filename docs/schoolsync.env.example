# SchoolSync / WebUntis
WEBUNTIS_BASE_URL=https://neilo.webuntis.com/WebUntis/?school=YOUR_SCHOOL
WEBUNTIS_STATE_FILE=/opt/liva/var/playwright/webuntis_state.json
WEBUNTIS_HEADLESS=true

# Optional tuning
# WEBUNTIS_WAIT_TIMEOUT_MS=12000
# WEBUNTIS_NAV_TIMEOUT_MS=30000
# WEBUNTIS_RETRIES=2
# WEBUNTIS_LATEST_TODAY_FILE=/opt/liva/var/schoolsync/latest_today.json
# WEBUNTIS_DEBUG=true
# WEBUNTIS_DEBUG_DIR=/opt/liva/var/schoolsync/debug

# Optional WebUntis EVA/Entfall alerts via ntfy
# NTFY_TOPIC=your-topic
# NTFY_BASE_URL=https://ntfy.sh
# NTFY_TOKEN=
# Alternative names, only for this watcher:
# WEBUNTIS_NTFY_TOPIC=your-topic
# WEBUNTIS_NTFY_TOKEN=
