#!/usr/bin/env bash
# Root-owned entry point.  No user supplied git, unit, or shell arguments.
set -euo pipefail
[[ $# -ge 1 ]] || exit 64
case "$1" in
  start)
    [[ $# -eq 1 ]] || exit 64
    exec /bin/systemctl start liva-release.service
    ;;
  restart)
    [[ $# -eq 2 ]] || exit 64
    case "$2" in
      liva.service|liva-mcp-remote.service) exec /bin/systemctl restart "$2" ;;
      *) exit 64 ;;
    esac
    ;;
  *) exit 64 ;;
esac
