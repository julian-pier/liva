[Unit]
Description=LIVA LIVA Endurance to Intervals.icu sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=liva
WorkingDirectory=/opt/liva
EnvironmentFile=-/opt/liva/.env
ExecStart=/opt/liva/venv/bin/python -m jobs.endurance_intervals_sync
Nice=10

[Install]
WantedBy=multi-user.target
