[Unit]
Description=LIVA Kienzl phrase refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=liva
WorkingDirectory=/opt/liva
EnvironmentFile=-/opt/liva/.env
ExecStart=/opt/liva/venv/bin/python -m jobs.kienzl_refresh
Nice=10

[Install]
WantedBy=multi-user.target

