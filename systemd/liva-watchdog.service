[Unit]
Description=LIVA LIVA watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=liva
WorkingDirectory=/opt/liva
EnvironmentFile=-/opt/liva/.env
ExecStart=/opt/liva/venv/bin/python /opt/liva/scripts/liva_watchdog.py
Nice=10

[Install]
WantedBy=multi-user.target
